From b828377cc5c926f84c5c209ae41a52795c205228 Mon Sep 17 00:00:00 2001
From: Jason Wong <usernameunknown@yahoo.com>
Date: Sat, 12 Sep 2026 20:20:00 -1000
Subject: [PATCH 1/3] Always prefer FirstPylon for nat_wall pylons after 60s.

Late nat-wall pylons were taking the closer production slot, which can leave most wall 3x3s unpowered (e.g. Magannatha).
---
 src/ares/build_runner/build_order_runner.py | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/ares/build_runner/build_order_runner.py b/src/ares/build_runner/build_order_runner.py
index 72789531..f3c56bab 100644
--- a/src/ares/build_runner/build_order_runner.py
+++ b/src/ares/build_runner/build_order_runner.py
@@ -627,11 +627,21 @@ class BuildOrderRunner:
                 base_location = self.ai.start_location
             else:
                 base_location = self._get_target(target)
+            # Nat-wall FirstPylon is often past 60s (e.g. Chargelot 22 @ nat_wall).
+            # Without first_pylon=True the BO picks the closer production wall pylon,
+            # which may not cover all ThreeByThreesWall slots (Magannatha: 1 of 3).
+            use_first_pylon = self.ai.race == Race.Protoss and (
+                self.ai.time < 60.0
+                or (
+                    structure_type == UnitTypeId.PYLON
+                    and target == BuildOrderTargetOptions.NAT_WALL
+                )
+            )
             if pos := self.mediator.request_building_placement(
                 base_location=base_location,
                 structure_type=structure_type,
                 wall=at_wall,
-                first_pylon=self.ai.time < 60.0 and self.ai.race == Race.Protoss,
+                first_pylon=use_first_pylon,
                 within_psionic_matrix=within_psionic_matrix,
                 pylon_build_progress=0.5,
                 reserve_placement=False,
